{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["chrome"],
    "sourceMap":false
  },
  "include": ["src/background/**/*.ts","src/popup.ts", "src/content/**/*.ts",
    "src/detectors/**/*.ts","src/storage/**/*.ts","src/types/**/*.ts"]
}
