{
  "manifest_version": 3,
  "name": "WebTrace",
  "version": "0.1.0",
  "description": "Website data transparency and privacy auditing.",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
"content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["content/scriptBridge.js"],
    "run_at": "document_start",
    "world": "ISOLATED"
  },
  {
    "matches": ["<all_urls>"],
    "js": ["detectors/storage.js"],
    "run_at": "document_start",
    "world": "MAIN"
  },
  {
  "matches": ["<all_urls>"],
  "js": ["detectors/geolocation.js"],
  "run_at": "document_start",
  "world": "MAIN"
  },
   {
  "matches": ["<all_urls>"],
  "js": ["detectors/cookie.js"],
  "run_at": "document_start",
  "world": "MAIN"
  },
  {
  "matches": ["<all_urls>"],
  "js": ["detectors/media.js"],
  "run_at": "document_start",
  "world": "MAIN"
  },
 {
  "matches": ["<all_urls>"],
  "js": ["detectors/canvas.js"],
  "run_at": "document_start",
  "world": "MAIN"
},
 {
  "matches": ["<all_urls>"],
  "js": ["detectors/webrtc.js"],
  "run_at": "document_start",
  "world": "MAIN"
}
]
}
